{
  "name": "recall-desk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npx convex deploy -y && npx @convex-dev/static-hosting upload --build --prod",
    "deploy:dev": "npx convex dev --once && npx @convex-dev/static-hosting upload --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workpool": "^0.4.11",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "convex-test": "^0.0.56",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
